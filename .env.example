# RPGy settings. Copy this file to .env.
# Players bring their own Gemini API key in the browser, so none of this is required to play.
# Everything below is optional.

# Share links and the live "players now" counter need a small Upstash Redis (REST) database.
# Without it, sharing answers 503 and everything else works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional voices (ElevenLabs) and talking-head video (Replicate).
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# Only for the server-side routes when you run RPGy without a player key (local development).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
